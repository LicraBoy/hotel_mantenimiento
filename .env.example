# ============================================
# Variables de Entorno — Hotel Mantenimiento
# ============================================
# Copia este archivo como .env y completa los valores

# Conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/hotel_mantenimiento

# Clave secreta de Flask (genera una con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia_esto_por_una_clave_secreta_segura
